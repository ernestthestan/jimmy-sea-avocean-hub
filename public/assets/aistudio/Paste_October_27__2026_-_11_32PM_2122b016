const WEEKDAYS = ['Su', 'Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa'];
const MONTHS = [
  'January', 'February', 'March', 'April', 'May', 'June',
  'July', 'August', 'September', 'October', 'November', 'December'
];
const SHORT_MONTHS = [
  'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun',
  'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'
];
const SHORT_DAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

// Helper to format YYYY-MM-DD
const toDateKey = (year, month, day) => {
  const m = String(month + 1).padStart(2, '0');
  const d = String(day).padStart(2, '0');
  return `${year}-${m}-${d}`;
};

// Parse YYYY-MM-DD safely in local time
const parseDateKey = (dateStr) => {
  const [y, m, d] = dateStr.split('-').map(Number);
  return new Date(y, m - 1, d);
};

// Custom SVG / Emoji Badge Component matching the screenshot's 3 overlapping icons
const MemberCircleIcon = ({ member, size = 'md', className = '' }) => {
  const sizeClasses = {
    xs: 'w-4 h-4 text-[9px]',
    sm: 'w-6 h-6 text-xs',
    md: 'w-7 h-7 text-sm',
    lg: 'w-11 h-11 text-xl'
  };

  return (
    <span
      style={{ backgroundColor: member.circleBg }}
      className={`inline-flex items-center justify-center rounded-full text-white select-none shrink-0 shadow-xs ${sizeClasses[size] || sizeClasses.md} ${className}`}
      title={member.name}
    >
      <span className="leading-none">{member.emoji}</span>
    </span>
  );
};

// Overlapping Trio Logo Component (used in top-left card and empty state card)
const TrioBadges = ({ members, size = 'sm' }) => {
  const dims =
    size === 'lg'
      ? { circle: 'w-12 h-12 text-xl border-[3px] border-white', overlap: '-ml-2.5' }
      : { circle: 'w-5 h-5 text-[10px] border-[1.5px] border-white', overlap: '-ml-1.5' };

  return (
    <div className="inline-flex items-center justify-center">
      {members.map((m, idx) => (
        <div
          key={m.id}
          style={{ backgroundColor: m.circleBg, zIndex: idx + 1 }}
          className={`rounded-full flex items-center justify-center text-white shadow-xs select-none ${dims.circle} ${
            idx > 0 ? dims.overlap : ''
          }`}
        >
          <span className="leading-none">{m.emoji}</span>
        </div>
      ))}
    </div>
  );
};

export default function App() {
  // Auth & Firestore State
  const [user, setUser] = useState(null);
  const [cloudSynced, setCloudSynced] = useState(false);

  // Schedule State (Defaults to Oct 28, 2026 as shown in screenshot)
  const [currentMonthDate, setCurrentMonthDate] = useState(() => new Date(2026, 9, 1));
  const [selectedDateStr, setSelectedDateStr] = useState('2026-10-28');
  const [showWeekOnly, setShowWeekOnly] = useState(false);
  const [activeTab, setActiveTab] = useState('calendar'); // 'calendar' | 'list'
  const [searchQuery, setSearchQuery] = useState('');

  // Settings & Events State
  const [settings, setSettings] = useState(DEFAULT_SETTINGS);
  const [events, setEvents] = useState(SAMPLE_EVENTS);
  const [activeMemberIds, setActiveMemberIds] = useState(['jimmy', 'sea', 'avocean']);

  // Edit Mode & Modals State
  const [isEditMode, setIsEditMode] = useState(false);
  const [eventModalOpen, setEventModalOpen] = useState(false);
  const [editingEvent, setEditingEvent] = useState(null);
  const [settingsModalOpen, setSettingsModalOpen] = useState(false);
  const [backupModalOpen, setBackupModalOpen] = useState(false);
  const [toastMessage, setToastMessage] = useState(null);

  // Event Form State
  const [formTitle, setFormTitle] = useState('');
  const [formDate, setFormDate] = useState('2026-10-28');
  const [formTime, setFormTime] = useState('');
  const [formLocation, setFormLocation] = useState('');
  const [formMembers, setFormMembers] = useState(['jimmy']);
  const [formCategory, setFormCategory] = useState('Event');
  const [formLink, setFormLink] = useState('');
  const [formNotes, setFormNotes] = useState('');

  // Settings Form State
  const [draftGreeting, setDraftGreeting] = useState(settings.greeting);
  const [draftBannerTitle, setDraftBannerTitle] = useState(settings.bannerTitle);
  const [draftBannerSubtitle, setDraftBannerSubtitle] = useState(settings.bannerSubtitle);
  const [draftBannerTag, setDraftBannerTag] = useState(settings.bannerTag);
  const [draftBannerImageUrl, setDraftBannerImageUrl] = useState(settings.bannerImageUrl);
  const [draftBannerPreset, setDraftBannerPreset] = useState(settings.bannerPreset);
  const [draftMembers, setDraftMembers] = useState(settings.members);
  const [importJsonText, setImportJsonText] = useState('');

  const showToast = (msg) => {
    setToastMessage(msg);
    setTimeout(() => {
      setToastMessage((prev) => (prev === msg ? null : prev));
    }, 3000);
  };

  // 1. Firebase Auth Effect
  useEffect(() => {
    if (!auth) return;
    const initAuth = async () => {
      try {
        if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
          await signInWithCustomToken(auth, __initial_auth_token);
        } else {
          await signInAnonymously(auth);
        }
      } catch (err) {
        console.error('Auth sign-in error:', err);
      }
    };
    initAuth();
    const unsubscribe = onAuthStateChanged(auth, (u) => {
      setUser(u);
    });
    return () => unsubscribe();
  }, []);

  // 2. Firestore Data Sync Effect
  useEffect(() => {
    if (!user || !db) return;

    const settingsDocRef = doc(db, 'artifacts', appId, 'public', 'data', 'schedule_config', 'main');
    const eventsColRef = collection(db, 'artifacts', appId, 'public', 'data', 'schedule_events');

    const unsubSettings = onSnapshot(
      settingsDocRef,
      (snap) => {
        if (snap.exists()) {
          const data = snap.data();
          if (data.greeting && Array.isArray(data.members)) {
            setSettings({
              ...DEFAULT_SETTINGS,
              ...data
            });
          }
        }
        setCloudSynced(true);
      },
      (err) => {
        console.error('Settings sync error:', err);
      }
    );

    const unsubEvents = onSnapshot(
      eventsColRef,
      (snap) => {
        if (!snap.empty) {
          const loaded = [];
          snap.forEach((d) => {
            const item = d.data();
            if (!item.deleted) {
              loaded.push({ ...item, id: d.id });
            }
          });
          setEvents(loaded);
        }
        setCloudSynced(true);
      },
      (err) => {
        console.error('Events sync error:', err);
      }
    );

    return () => {
      unsubSettings();
      unsubEvents();
    };
  }, [user]);

  // Save Settings helper
  const saveSettingsToCloud = async (newSettings) => {
    setSettings(newSettings);
    if (user && db) {
      try {
        const settingsDocRef = doc(db, 'artifacts', appId, 'public', 'data', 'schedule_config', 'main');
        await setDoc(settingsDocRef, newSettings);
      } catch (e) {
        console.error('Failed to save settings:', e);
      }
    }
  };

  // Save Event helper
  const saveEventToCloud = async (eventObj) => {
    setEvents((prev) => {
      const exists = prev.some((e) => e.id === eventObj.id);
      return exists ? prev.map((e) => (e.id === eventObj.id ? eventObj : e)) : [...prev, eventObj];
    });

    if (user && db) {
      try {
        const eventDocRef = doc(db, 'artifacts', appId, 'public', 'data', 'schedule_events', eventObj.id);
        await setDoc(eventDocRef, eventObj);
      } catch (e) {
        console.error('Failed to save event:', e);
      }
    }
  };

  // Delete Event helper
  const deleteEventFromCloud = async (eventId) => {
    setEvents((prev) => prev.filter((e) => e.id !== eventId));
    if (user && db) {
      try {
        const eventDocRef = doc(db, 'artifacts', appId, 'public', 'data', 'schedule_events', eventId);
        await deleteDoc(eventDocRef);
      } catch (e) {
        console.error('Failed to delete event:', e);
      }
    }
    showToast('Event deleted');
  };

  // Toggle Member Filter Pill
  const toggleMemberFilter = (memberId) => {
    setActiveMemberIds((prev) => {
      if (prev.includes(memberId)) {
        // Don't allow turning off all members; if last one clicked, reset all on
        if (prev.length === 1) return settings.members.map((m) => m.id);
        return prev.filter((id) => id !== memberId);
      }
      return [...prev, memberId];
    });
  };

  // Calendar Navigation
  const handlePrevMonth = () => {
    setCurrentMonthDate((prev) => new Date(prev.getFullYear(), prev.getMonth() - 1, 1));
  };

  const handleNextMonth = () => {
    setCurrentMonthDate((prev) => new Date(prev.getFullYear(), prev.getMonth() + 1, 1));
  };

  const handleJumpToToday = () => {
    // Matches the screenshot's October 28, 2026 default "Today"
    const todayYear = 2026;
    const todayMonth = 9; // October (0-indexed)
    const todayDay = 28;
    setCurrentMonthDate(new Date(todayYear, todayMonth, 1));
    setSelectedDateStr(toDateKey(todayYear, todayMonth, todayDay));
  };

  // Build Calendar Grid for Current Month
  const calendarDays = useMemo(() => {
    const year = currentMonthDate.getFullYear();
    const month = currentMonthDate.getMonth();
    const firstDayOfWeek = new Date(year, month, 1).getDay(); // 0 (Sun) to 6 (Sat)
    const daysInMonth = new Date(year, month + 1, 0).getDate();

    const cells = [];
    for (let i = 0; i < firstDayOfWeek; i++) {
      cells.push(null);
    }
    for (let day = 1; day <= daysInMonth; day++) {
      cells.push({
        day,
        dateStr: toDateKey(year, month, day)
      });
    }
    // Pad trailing cells so rows are complete groups of 7
    while (cells.length % 7 !== 0) {
      cells.push(null);
    }

    // Group into weeks
    const weeks = [];
    for (let i = 0; i < cells.length; i += 7) {
      weeks.push(cells.slice(i, i + 7));
    }
    return weeks;
  }, [currentMonthDate]);

  // Filter weeks if "Show week only" is enabled
  const displayedWeeks = useMemo(() => {
    if (!showWeekOnly) return calendarDays;
    const matchingWeek = calendarDays.find((week) =>
      week.some((cell) => cell && cell.dateStr === selectedDateStr)
    );
    return matchingWeek ? [matchingWeek] : [calendarDays[0]];
  }, [calendarDays, showWeekOnly, selectedDateStr]);

  // Filtered Events based on active member pills
  const filteredEvents = useMemo(() => {
    return events.filter((ev) =>
      (ev.members || []).some((mId) => activeMemberIds.includes(mId))
    );
  }, [events, activeMemberIds]);

  // Map dateStr -> list of filtered events
  const eventsByDate = useMemo(() => {
    const map = {};
    filteredEvents.forEach((ev) => {
      if (!map[ev.date]) map[ev.date] = [];
      map[ev.date].push(ev);
    });
    // Sort each day's events by time
    Object.keys(map).forEach((k) => {
      map[k].sort((a, b) => (a.time || '').localeCompare(b.time || ''));
    });
    return map;
  }, [filteredEvents]);

  // Events for the currently selected day
  const selectedDayEvents = eventsByDate[selectedDateStr] || [];

  // Formatted Selected Date Header (e.g., "Wed 28 Oct")
  const formattedSelectedDate = useMemo(() => {
    const dt = parseDateKey(selectedDateStr);
    const dayName = SHORT_DAYS[dt.getDay()];
    const dayNum = dt.getDate();
    const monthName = SHORT_MONTHS[dt.getMonth()];
    return `${dayName} ${dayNum} ${monthName}`;
  }, [selectedDateStr]);

  // Open Add Event Modal
  const openAddEventModal = (defaultDate = selectedDateStr) => {
    setEditingEvent(null);
    setFormTitle('');
    setFormDate(defaultDate);
    setFormTime('18:00 BKK');
    setFormLocation('');
    setFormMembers(['jimmy', 'sea']);
    setFormCategory('Event');
    setFormLink('');
    setFormNotes('');
    setEventModalOpen(true);
  };

  // Open Edit Event Modal
  const openEditEventModal = (ev) => {
    setEditingEvent(ev);
    setFormTitle(ev.title || '');
    setFormDate(ev.date || selectedDateStr);
    setFormTime(ev.time || '');
    setFormLocation(ev.location || '');
    setFormMembers(ev.members && ev.members.length ? ev.members : ['jimmy']);
    setFormCategory(ev.category || 'Event');
    setFormLink(ev.link || '');
    setFormNotes(ev.notes || '');
    setEventModalOpen(true);
  };

  // Submit Add/Edit Event Form
  const handleSaveEvent = async (e) => {
    e.preventDefault();
    if (!formTitle.trim()) return;

    const newEvent = {
      id: editingEvent ? editingEvent.id : `ev-${Date.now()}`,
      title: formTitle.trim(),
      date: formDate,
      time: formTime.trim(),
      location: formLocation.trim(),
      members: formMembers.length > 0 ? formMembers : [settings.members[0].id],
      category: formCategory,
      link: formLink.trim(),
      notes: formNotes.trim()
    };

    await saveEventToCloud(newEvent);
    setSelectedDateStr(formDate);
    const dt = parseDateKey(formDate);
    setCurrentMonthDate(new Date(dt.getFullYear(), dt.getMonth(), 1));
    setEventModalOpen(false);
    showToast(editingEvent ? 'Event updated!' : 'Event added to calendar!');
  };

  // Open Settings Modal
  const openSettingsModal = () => {
    setDraftGreeting(settings.greeting || DEFAULT_SETTINGS.greeting);
    setDraftBannerTitle(settings.bannerTitle ?? DEFAULT_SETTINGS.bannerTitle);
    setDraftBannerSubtitle(settings.bannerSubtitle ?? DEFAULT_SETTINGS.bannerSubtitle);
    setDraftBannerTag(settings.bannerTag ?? DEFAULT_SETTINGS.bannerTag);
    setDraftBannerImageUrl(settings.bannerImageUrl ?? '');
    setDraftBannerPreset(settings.bannerPreset || 'avocean-dream');
    setDraftMembers(settings.members.map((m) => ({ ...m })));
    setSettingsModalOpen(true);
  };

  // Save Settings Modal
  const handleSaveSettings = async (e) => {
    e.preventDefault();
    const cleaned = {
      greeting: draftGreeting.trim() || 'Hey ErnestTheStan!',
      bannerTitle: draftBannerTitle.trim() || 'JIMMY & SEA • AVOCEAN HUB',
      bannerSubtitle:
        draftBannerSubtitle.trim() ||
        'Official Fan Schedule, Appearances & Trending Projects 🥑🌊💚',
      bannerTag: draftBannerTag.trim() || 'OFFICIAL SCHEDULE',
      bannerImageUrl: draftBannerImageUrl.trim(),
      bannerPreset: draftBannerPreset || 'avocean-dream',
      members: draftMembers.map((m) => ({
        ...m,
        name: m.name.trim() || 'Member',
        emoji: m.emoji.trim() || '⭐'
      }))
    };
    await saveSettingsToCloud(cleaned);
    setSettingsModalOpen(false);
    showToast('Banner, Header & Member profiles saved!');
  };

  // Export JSON Backup
  const handleDownloadBackup = () => {
    const payload = JSON.stringify({ settings, events }, null, 2);
    const blob = new Blob([payload], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `schedule-backup-${selectedDateStr}.json`;
    a.click();
    URL.revokeObjectURL(url);
    showToast('Schedule backup downloaded!');
  };

  // Import JSON Backup
  const handleImportBackup = async () => {
    try {
      const parsed = JSON.parse(importJsonText);
      if (parsed.settings) {
        await saveSettingsToCloud(parsed.settings);
      }
      if (Array.isArray(parsed.events)) {
        for (const ev of parsed.events) {
          if (ev.id && ev.title && ev.date) {
            await saveEventToCloud(ev);
          }
        }
      }
      setImportJsonText('');
      setBackupModalOpen(false);
      showToast('Schedule imported successfully!');
    } catch (err) {
      showToast('Invalid JSON format. Please check your backup data.');
    }
  };

  // Lookup member object by id
  const getMemberById = (id) =>
    settings.members.find((m) => m.id === id) || settings.members[0];

  // List View events sorted chronologically
  const listViewEvents = useMemo(() => {
    const q = searchQuery.trim().toLowerCase();
    return [...filteredEvents]
      .filter((ev) => {
        if (!q) return true;
        return (
          ev.title?.toLowerCase().includes(q) ||
          ev.location?.toLowerCase().includes(q) ||
          ev.notes?.toLowerCase().includes(q) ||
          ev.date?.includes(q)
        );
      })
      .sort((a, b) => {
        if (a.date !== b.date) return a.date.localeCompare(b.date);
        return (a.time || '').localeCompare(b.time || '');
      });
  }, [filteredEvents, searchQuery]);

  return (
    <div
      className="min-h-screen w-full flex flex-col items-center pb-28 px-4 pt-5 select-none sm:select-auto relative transition-colors"
      style={{
        background: 'linear-gradient(180deg, #FDF6E2 0%, #F5F4EC 48%, #E5F0F8 100%)',
        fontFamily: "'Quicksand', 'Nunito', 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif",
        color: '#1A3668'
      }}
    >
      {/* Google Font Loader for rounded friendly typography */}
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=Quicksand:wght@500;600;700&display=swap');
      `}</style>

      {/* Toast Notification */}
      {toastMessage && (
        <div className="fixed top-4 left-1/2 -translate-x-1/2 z-50 bg-[#1A3668] text-white text-xs font-bold px-4 py-2.5 rounded-full shadow-lg flex items-center gap-2 animate-bounce">
          <Sparkles className="w-3.5 h-3.5 text-amber-300" />
          <span>{toastMessage}</span>
        </div>
      )}

      {/* Top Floating Quick-Editor Toolbar (Allows editing at any time!) */}
      <div className="w-full max-w-[740px] flex items-center justify-between mb-3 px-1">
        <div className="flex items-center gap-1.5">
          <button
            onClick={() => setIsEditMode(!isEditMode)}
            className={`inline-flex items-center gap-1.5 text-xs font-bold px-3 py-1.5 rounded-full transition-all shadow-2xs border cursor-pointer ${
              isEditMode
                ? 'bg-[#1A3668] text-white border-[#1A3668]'
                : 'bg-white/80 hover:bg-white text-[#1A3668] border-white/60'
            }`}
          >
            <Edit3 className="w-3.5 h-3.5" />
            <span>{isEditMode ? 'Editing Active' : 'Edit Schedule'}</span>
          </button>

          {isEditMode && (
            <button
              onClick={openSettingsModal}
              className="inline-flex items-center gap-1 text-xs font-bold px-2.5 py-1.5 rounded-full bg-white text-[#1A3668] hover:bg-purple-50 shadow-2xs border border-purple-100 transition-all cursor-pointer"
              title="Customize Banner, Greeting & Members"
            >
              <Settings className="w-3.5 h-3.5 text-purple-600" />
              <span>Customize Banner & Info</span>
            </button>
          )}
        </div>

        <div className="flex items-center gap-1.5">
          {isEditMode && (
            <button
              onClick={() => setBackupModalOpen(true)}
              className="inline-flex items-center gap-1 text-xs font-bold p-1.5 rounded-full bg-white text-[#1A3668] hover:bg-sky-50 shadow-2xs border border-sky-100 cursor-pointer"
              title="Backup or Import Schedule"
            >
              <Download className="w-3.5 h-3.5 text-sky-600" />
            </button>
          )}
          <button
            onClick={() => openAddEventModal(selectedDateStr)}
            className="inline-flex items-center gap-1 text-xs font-bold px-3 py-1.5 rounded-full bg-purple-600 hover:bg-purple-700 text-white shadow-xs transition-all cursor-pointer"
          >
            <Plus className="w-3.5 h-3.5" />
            <span>Add Event</span>
          </button>
        </div>
      </div>

      {/* NEW: TOP HERO BANNER */}
      <div className="w-full max-w-[740px] mb-6">
        <div
          style={{
            background: settings.bannerImageUrl
              ? `linear-gradient(90deg, rgba(255,255,255,0.88) 0%, rgba(255,255,255,0.65) 100%), url(${settings.bannerImageUrl}) center/cover no-repeat`
              : (
                  BANNER_PRESETS.find((p) => p.id === settings.bannerPreset) ||
                  BANNER_PRESETS[0]
                ).gradient
          }}
          className="relative w-full rounded-[28px] shadow-xs border-2 border-white/80 px-6 py-6 sm:px-8 sm:py-7 overflow-hidden flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4"
        >
          {/* Decorative Soft Bubbles inside Banner */}
          <div className="pointer-events-none absolute -right-10 -top-10 w-36 h-36 rounded-full bg-white/30 blur-xl" />
          <div className="pointer-events-none absolute right-20 -bottom-12 w-28 h-28 rounded-full bg-white/25 blur-lg" />

          <div className="relative z-10 flex flex-col max-w-lg">
            {settings.bannerTag && (
              <span className="inline-flex items-center gap-1.5 self-start text-[10.5px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-white/85 text-[#1A3668] shadow-2xs mb-2">
                <Sparkles className="w-3 h-3 text-purple-600" />
                {settings.bannerTag}
              </span>
            )}
            <h2 className="text-xl sm:text-2xl font-bold text-[#1A3668] tracking-tight leading-tight">
              {settings.bannerTitle || DEFAULT_SETTINGS.bannerTitle}
            </h2>
            <p className="text-xs sm:text-[13.5px] font-semibold text-[#3B5284] mt-1">
              {settings.bannerSubtitle || DEFAULT_SETTINGS.bannerSubtitle}
            </p>
          </div>

          <div className="relative z-10 flex items-center gap-3 self-end sm:self-center">
            <div className="bg-white/90 backdrop-blur-xs px-3.5 py-2.5 rounded-2xl shadow-xs flex items-center gap-2 border border-white">
              <TrioBadges members={settings.members} size="sm" />
              <span className="text-xs font-bold text-[#1A3668] pl-0.5">
                {events.length} Events
              </span>
            </div>

            {isEditMode && (
              <button
                onClick={openSettingsModal}
                className="inline-flex items-center gap-1.5 px-3 py-2 rounded-2xl bg-[#1A3668] text-white text-xs font-bold shadow-xs hover:bg-slate-800 transition-all cursor-pointer"
                title="Edit Banner Image & Text"
              >
                <ImageIcon className="w-3.5 h-3.5" />
                <span>Edit Banner</span>
              </button>
            )}
          </div>
        </div>
      </div>

      {/* Main Content Layout: Calendar Column on the Left + Jimmy, Sea, Avocean Filter Column on the Right */}
      <div className="w-full max-w-[740px] flex flex-col md:flex-row items-start justify-center gap-5">
        {/* LEFT / MAIN SCHEDULE COLUMN */}
        <div className="w-full md:flex-1 max-w-[430px] mx-auto md:mx-0 flex flex-col order-2 md:order-1">
          {/* 1. HEADER ROW */}
          <div className="flex items-center justify-between mb-4">
            <div className="flex items-center gap-3">
              {/* Rounded Square Card with 3 Overlapping Member Badges */}
              <button
                onClick={() => isEditMode && openSettingsModal()}
                className={`w-13 h-13 rounded-2xl bg-white shadow-xs flex items-center justify-center relative shrink-0 ${
                  isEditMode ? 'ring-2 ring-purple-300 cursor-pointer' : ''
                }`}
                title={isEditMode ? 'Click to customize members & header' : 'Member Badges'}
              >
                <TrioBadges members={settings.members} size="sm" />
              </button>

              {/* Greeting & Month Title */}
              <div className="flex flex-col">
                <div className="flex items-center gap-1">
                  <span className="text-[11.5px] font-semibold text-[#607494] tracking-tight leading-tight">
                    {settings.greeting}
                  </span>
                  {isEditMode && (
                    <button
                      onClick={openSettingsModal}
                      className="text-purple-600 hover:text-purple-800 p-0.5 cursor-pointer"
                      title="Edit Greeting"
                    >
                      <Edit3 className="w-3 h-3" />
                    </button>
                  )}
                </div>
                <h1 className="text-[23px] font-bold text-[#1A3668] leading-tight tracking-tight">
                  {MONTHS[currentMonthDate.getMonth()]}
                  {currentMonthDate.getFullYear() !== 2026
                    ? ` '${String(currentMonthDate.getFullYear()).slice(-2)}`
                    : ''}
                </h1>
              </div>
            </div>

            {/* Right Navigation Controls: <  >  Today */}
            <div className="flex items-center gap-2">
              <button
                onClick={handlePrevMonth}
                className="w-9 h-9 rounded-full bg-white hover:bg-slate-50 active:scale-95 transition-all shadow-xs flex items-center justify-center text-[#1A3668] cursor-pointer"
                aria-label="Previous Month"
              >
                <ChevronLeft className="w-4 h-4 stroke-[2.4]" />
              </button>
              <button
                onClick={handleNextMonth}
                className="w-9 h-9 rounded-full bg-white hover:bg-slate-50 active:scale-95 transition-all shadow-xs flex items-center justify-center text-[#1A3668] cursor-pointer"
                aria-label="Next Month"
              >
                <ChevronRight className="w-4 h-4 stroke-[2.4]" />
              </button>
              <button
                onClick={handleJumpToToday}
                className="h-9 px-4 rounded-full bg-white hover:bg-slate-50 active:scale-95 transition-all shadow-xs text-[13px] font-bold text-[#1A3668] cursor-pointer"
              >
                Today
              </button>
            </div>
          </div>

          {/* VIEW SWITCHER: CALENDAR VIEW vs LIST VIEW */}
          {activeTab === 'calendar' ? (
            <>
              {/* 3. CALENDAR WHITE CARD */}
              <div className="bg-white rounded-[26px] shadow-xs pt-5 pb-2 px-4 mb-6">
                {/* Weekday Headers */}
                <div className="grid grid-cols-7 mb-3">
                  {WEEKDAYS.map((day) => (
                    <div
                      key={day}
                      className="text-center text-[12px] font-bold text-[#526586]"
                    >
                      {day}
                    </div>
                  ))}
                </div>

                {/* Date Rows */}
                <div className="flex flex-col gap-3">
                  {displayedWeeks.map((week, wIdx) => (
                    <div key={wIdx} className="grid grid-cols-7 items-start">
                      {week.map((cell, cIdx) => {
                        if (!cell) {
                          return <div key={`empty-${cIdx}`} className="h-11" />;
                        }

                        const isSelected = cell.dateStr === selectedDateStr;
                        const dayEvents = eventsByDate[cell.dateStr] || [];

                        // Collect unique member icons for events on this date
                        const dayMemberIds = Array.from(
                          new Set(dayEvents.flatMap((e) => e.members || []))
                        ).filter((id) => activeMemberIds.includes(id));

                        return (
                          <button
                            key={cell.dateStr}
                            onClick={() => setSelectedDateStr(cell.dateStr)}
                            className="flex flex-col items-center justify-start py-0.5 group cursor-pointer focus:outline-none min-h-[44px]"
                          >
                            <div
                              className={`w-8 h-8 rounded-full flex items-center justify-center text-[13px] transition-all ${
                                isSelected
                                  ? 'bg-[#1A3668] text-white font-bold shadow-xs'
                                  : 'text-[#2E4775] font-semibold group-hover:bg-slate-100'
                              }`}
                            >
                              {cell.day}
                            </div>

                            {/* Tiny Member Marks under the date if events exist */}
                            {dayMemberIds.length > 0 && (
                              <div className="flex items-center justify-center -space-x-1 mt-0.5">
                                {dayMemberIds.slice(0, 3).map((mId) => {
                                  const m = getMemberById(mId);
                                  return (
                                    <span
                                      key={mId}
                                      style={{ backgroundColor: m.circleBg }}
                                      className="w-3.5 h-3.5 rounded-full text-[8px] flex items-center justify-center text-white ring-1 ring-white shadow-2xs"
                                    >
                                      {m.emoji}
                                    </span>
                                  );
                                })}
                              </div>
                            )}
                          </button>
                        );
                      })}
                    </div>
                  ))}
                </div>

                {/* Bottom Divider & "Show week only" Toggle */}
                <div className="border-t border-slate-100 mt-4 pt-2.5 pb-1 flex justify-center">
                  <button
                    onClick={() => setShowWeekOnly(!showWeekOnly)}
                    className="inline-flex items-center gap-1.5 text-[12.5px] font-bold text-[#1A3668] hover:text-purple-700 py-1 px-3 rounded-full transition-colors cursor-pointer"
                  >
                    {showWeekOnly ? (
                      <>
                        <ChevronDown className="w-3.5 h-3.5 stroke-[2.5]" />
                        <span>Show full month</span>
                      </>
                    ) : (
                      <>
                        <ChevronUp className="w-3.5 h-3.5 stroke-[2.5]" />
                        <span>Show week only</span>
                      </>
                    )}
                  </button>
                </div>
              </div>

              {/* 4. SELECTED DAY SCHEDULE HEADER */}
              <div className="flex items-center justify-between px-1 mb-3">
                <h2 className="text-[17px] font-bold text-[#1A3668]">
                  {formattedSelectedDate}
                </h2>
                <div className="flex items-center gap-2">
                  <span className="text-[12.5px] font-semibold text-[#607494]">
                    {selectedDayEvents.length === 0
                      ? 'No events'
                      : `${selectedDayEvents.length} ${
                          selectedDayEvents.length === 1 ? 'event' : 'events'
                        }`}
                  </span>
                  {isEditMode && (
                    <button
                      onClick={() => openAddEventModal(selectedDateStr)}
                      className="text-xs font-bold text-purple-700 bg-purple-100 hover:bg-purple-200 px-2.5 py-1 rounded-full transition-colors cursor-pointer"
                    >
                      + Add
                    </button>
                  )}
                </div>
              </div>

              {/* 5. SELECTED DAY EVENTS OR EMPTY STATE CARD */}
              {selectedDayEvents.length === 0 ? (
                <div className="bg-white rounded-[26px] shadow-xs py-11 px-6 flex flex-col items-center justify-center text-center">
                  <div className="mb-3.5">
                    <TrioBadges members={settings.members} size="lg" />
                  </div>
                  <h3 className="text-[16px] font-bold text-[#1A3668] mb-1">
                    No events on this day
                  </h3>
                  <p className="text-[13px] font-medium text-[#607494]">
                    Try a day with a mark on the calendar
                  </p>

                  {/* Helpful subtle button to add an event directly on this empty day */}
                  <button
                    onClick={() => openAddEventModal(selectedDateStr)}
                    className="mt-4 inline-flex items-center gap-1.5 text-xs font-bold text-[#1A3668] bg-slate-100/80 hover:bg-purple-100/80 hover:text-purple-900 px-3.5 py-2 rounded-full transition-all cursor-pointer"
                  >
                    <Plus className="w-3.5 h-3.5" />
                    <span>Add event on {formattedSelectedDate}</span>
                  </button>
                </div>
              ) : (
                <div className="flex flex-col gap-3">
                  {selectedDayEvents.map((ev) => (
                    <div
                      key={ev.id}
                      className="bg-white rounded-[24px] shadow-xs p-4 border border-white hover:border-purple-100 transition-all"
                    >
                      <div className="flex items-start justify-between gap-2 mb-2">
                        {/* Member Pills for this Event */}
                        <div className="flex flex-wrap items-center gap-1.5">
                          {(ev.members || []).map((mId) => {
                            const m = getMemberById(mId);
                            return (
                              <span
                                key={mId}
                                style={{
                                  backgroundColor: m.pillBg,
                                  borderColor: m.pillBorder
                                }}
                                className="inline-flex items-center gap-1 px-2 py-0.5 rounded-full border text-[11px] font-bold text-[#1A3668]"
                              >
                                <span>{m.emoji}</span>
                                <span>{m.name}</span>
                              </span>
                            );
                          })}
                          {ev.category && (
                            <span className="text-[10.5px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-slate-100 text-[#607494]">
                              {ev.category}
                            </span>
                          )}
                        </div>

                        {/* Edit / Delete Buttons */}
                        <div className="flex items-center gap-1 shrink-0">
                          <button
                            onClick={() => openEditEventModal(ev)}
                            className="p-1.5 rounded-full text-slate-400 hover:text-[#1A3668] hover:bg-slate-100 transition-colors cursor-pointer"
                            title="Edit Event"
                          >
                            <Edit3 className="w-3.5 h-3.5" />
                          </button>
                          <button
                            onClick={() => deleteEventFromCloud(ev.id)}
                            className="p-1.5 rounded-full text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition-colors cursor-pointer"
                            title="Delete Event"
                          >
                            <Trash2 className="w-3.5 h-3.5" />
                          </button>
                        </div>
                      </div>

                      <h3 className="text-[15.5px] font-bold text-[#1A3668] leading-snug mb-2">
                        {ev.title}
                      </h3>

                      <div className="flex flex-wrap items-center gap-x-4 gap-y-1 text-[12.5px] font-semibold text-[#607494]">
                        {ev.time && (
                          <div className="inline-flex items-center gap-1">
                            <Clock className="w-3.5 h-3.5 text-purple-500" />
                            <span>{ev.time}</span>
                          </div>
                        )}
                        {ev.location && (
                          <div className="inline-flex items-center gap-1">
                            <MapPin className="w-3.5 h-3.5 text-sky-500" />
                            <span>{ev.location}</span>
                          </div>
                        )}
                      </div>

                      {ev.notes && (
                        <p className="mt-2 text-[12px] font-medium text-[#526586] bg-slate-50 rounded-xl px-3 py-2">
                          {ev.notes}
                        </p>
                      )}

                      {ev.link && (
                        <div className="mt-2.5 pt-2 border-t border-slate-100 flex justify-end">
                          <a
                            href={ev.link}
                            target="_blank"
                            rel="noopener noreferrer"
                            className="inline-flex items-center gap-1 text-xs font-bold text-purple-600 hover:text-purple-800"
                          >
                            <span>Event Link</span>
                            <ExternalLink className="w-3 h-3" />
                          </a>
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              )}
            </>
          ) : (
            /* LIST VIEW TAB */
            <div className="flex flex-col gap-3">
              {/* Search bar inside List View */}
              <div className="bg-white rounded-full shadow-xs px-4 py-2.5 flex items-center gap-2 mb-1">
                <Search className="w-4 h-4 text-[#607494]" />
                <input
                  type="text"
                  value={searchQuery}
                  onChange={(e) => setSearchQuery(e.target.value)}
                  placeholder="Search schedule, locations, notes..."
                  className="w-full text-[13px] font-semibold text-[#1A3668] placeholder-[#94A3B8] focus:outline-none bg-transparent"
                />
                {searchQuery && (
                  <button
                    onClick={() => setSearchQuery('')}
                    className="text-slate-400 hover:text-slate-600"
                  >
                    <X className="w-4 h-4" />
                  </button>
                )}
              </div>

              {listViewEvents.length === 0 ? (
                <div className="bg-white rounded-[26px] shadow-xs py-11 px-6 flex flex-col items-center justify-center text-center">
                  <TrioBadges members={settings.members} size="lg" />
                  <h3 className="text-[16px] font-bold text-[#1A3668] mt-3 mb-1">
                    No matching events found
                  </h3>
                  <p className="text-[13px] font-medium text-[#607494] mb-4">
                    Add a new schedule item or adjust your member filters on the right
                  </p>
                  <button
                    onClick={() => openAddEventModal(selectedDateStr)}
                    className="inline-flex items-center gap-1.5 text-xs font-bold text-white bg-[#1A3668] px-4 py-2 rounded-full shadow-xs cursor-pointer"
                  >
                    <Plus className="w-3.5 h-3.5" />
                    <span>Add Schedule Event</span>
                  </button>
                </div>
              ) : (
                listViewEvents.map((ev) => {
                  const dt = parseDateKey(ev.date);
                  const dateBadge = `${SHORT_DAYS[dt.getDay()]}, ${dt.getDate()} ${
                    SHORT_MONTHS[dt.getMonth()]
                  }`;

                  return (
                    <div
                      key={ev.id}
                      className="bg-white rounded-[24px] shadow-xs p-4 hover:shadow-md transition-all"
                    >
                      <div className="flex items-center justify-between mb-2">
                        <button
                          onClick={() => {
                            setSelectedDateStr(ev.date);
                            setCurrentMonthDate(new Date(dt.getFullYear(), dt.getMonth(), 1));
                            setActiveTab('calendar');
                          }}
                          className="text-xs font-bold text-purple-700 bg-purple-50 hover:bg-purple-100 px-2.5 py-1 rounded-full cursor-pointer"
                        >
                          {dateBadge}
                        </button>

                        <div className="flex items-center gap-1">
                          <button
                            onClick={() => openEditEventModal(ev)}
                            className="p-1.5 rounded-full text-slate-400 hover:text-[#1A3668] hover:bg-slate-100"
                            title="Edit Event"
                          >
                            <Edit3 className="w-3.5 h-3.5" />
                          </button>
                          <button
                            onClick={() => deleteEventFromCloud(ev.id)}
                            className="p-1.5 rounded-full text-slate-400 hover:text-rose-600 hover:bg-rose-50"
                            title="Delete Event"
                          >
                            <Trash2 className="w-3.5 h-3.5" />
                          </button>
                        </div>
                      </div>

                      <h3 className="text-[15px] font-bold text-[#1A3668] mb-1.5">
                        {ev.title}
                      </h3>

                      <div className="flex flex-wrap items-center gap-3 text-[12px] font-semibold text-[#607494] mb-2">
                        {ev.time && (
                          <span className="inline-flex items-center gap-1">
                            <Clock className="w-3.5 h-3.5 text-purple-500" />
                            {ev.time}
                          </span>
                        )}
                        {ev.location && (
                          <span className="inline-flex items-center gap-1">
                            <MapPin className="w-3.5 h-3.5 text-sky-500" />
                            {ev.location}
                          </span>
                        )}
                      </div>

                      <div className="flex items-center gap-1.5 flex-wrap">
                        {(ev.members || []).map((mId) => {
                          const m = getMemberById(mId);
                          return (
                            <span
                              key={mId}
                              style={{
                                backgroundColor: m.pillBg,
                                borderColor: m.pillBorder
                              }}
                              className="inline-flex items-center gap-1 px-2 py-0.5 rounded-full border text-[10.5px] font-bold text-[#1A3668]"
                            >
                              <span>{m.emoji}</span>
                              <span>{m.name}</span>
                            </span>
                          );
                        })}
                      </div>
                    </div>
                  );
                })
              )}
            </div>
          )}
        </div>

        {/* RIGHT SIDE COLUMN: JIMMY, SEA, AVOCEAN PILLS (Moved to the right!) */}
        <div className="w-full md:w-[250px] shrink-0 flex flex-col items-end md:items-stretch order-1 md:order-2">
          <div className="w-full bg-white/75 backdrop-blur-xs rounded-[26px] p-4 shadow-xs border border-white">
            <div className="flex items-center justify-between mb-3 px-1">
              <span className="text-xs font-bold uppercase tracking-wider text-[#607494]">
                Members Filter
              </span>
              <button
                onClick={() => setActiveMemberIds(settings.members.map((m) => m.id))}
                className="text-[11px] font-bold text-purple-700 hover:underline cursor-pointer"
              >
                Show All
              </button>
            </div>

            {/* Pills aligned to the right on mobile and stacked cleanly on the right sidebar on desktop */}
            <div className="flex flex-wrap justify-end md:flex-col gap-2.5">
              {settings.members.map((member) => {
                const isActive = activeMemberIds.includes(member.id);
                const memberEventCount = events.filter((e) =>
                  (e.members || []).includes(member.id)
                ).length;

                return (
                  <button
                    key={member.id}
                    onClick={() => toggleMemberFilter(member.id)}
                    style={{
                      backgroundColor: isActive ? member.pillBg : '#FFFFFF',
                      borderColor: isActive ? member.pillBorder : '#E2E8F0'
                    }}
                    className={`flex items-center justify-between gap-2.5 px-3 py-2.5 rounded-full border-[1.5px] transition-all cursor-pointer shadow-2xs ${
                      isActive ? 'opacity-100 scale-100' : 'opacity-50 hover:opacity-80'
                    }`}
                  >
                    <div className="flex items-center gap-2.5 min-w-0">
                      <MemberCircleIcon member={member} size="md" />
                      <span className="text-[13.5px] font-bold text-[#1A3668] truncate">
                        {member.name}
                      </span>
                    </div>
                    <span className="text-[11px] font-bold px-2 py-0.5 rounded-full bg-white/80 text-[#526586] shrink-0">
                      {memberEventCount}
                    </span>
                  </button>
                );
              })}
            </div>

            {isEditMode && (
              <button
                onClick={openSettingsModal}
                className="mt-3 w-full py-2 rounded-full bg-slate-100 hover:bg-purple-50 text-[11.5px] font-bold text-[#1A3668] flex items-center justify-center gap-1.5 transition-colors cursor-pointer"
              >
                <Edit3 className="w-3 h-3 text-purple-600" />
                <span>Edit Members</span>
              </button>
            )}
          </div>
        </div>
      </div>

      {/* 6. BOTTOM FLOATING NAVIGATION PILL (Calendar | List) */}
      <div className="fixed bottom-5 left-1/2 -translate-x-1/2 z-40">
        <div className="bg-white p-1.5 rounded-full shadow-md flex items-center gap-1 border border-slate-100">
          <button
            onClick={() => setActiveTab('calendar')}
            className={`inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-[13px] font-bold transition-all cursor-pointer ${
              activeTab === 'calendar'
                ? 'bg-[#EFE7FF] text-[#1A3668]'
                : 'text-[#526586] hover:text-[#1A3668]'
            }`}
          >
            <CalendarIcon className="w-4 h-4 stroke-[2.2]" />
            <span>Calendar</span>
          </button>
          <button
            onClick={() => setActiveTab('list')}
            className={`inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-[13px] font-bold transition-all cursor-pointer ${
              activeTab === 'list'
                ? 'bg-[#EFE7FF] text-[#1A3668]'
                : 'text-[#526586] hover:text-[#1A3668]'
            }`}
          >
            <ListIcon className="w-4 h-4 stroke-[2.2]" />
            <span>List</span>
          </button>
        </div>
      </div>

      {/* MODAL 1: ADD / EDIT EVENT */}
      {eventModalOpen && (
        <div className="fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-xs flex items-center justify-center p-4">
          <div className="bg-white rounded-[28px] shadow-xl w-full max-w-md p-6 animate-in fade-in zoom-in-95 duration-150 max-h-[90vh] overflow-y-auto">
            <div className="flex items-center justify-between mb-4">
              <h3 className="text-lg font-bold text-[#1A3668]">
                {editingEvent ? 'Edit Event' : 'Add Schedule Event'}
              </h3>
              <button
                onClick={() => setEventModalOpen(false)}
                className="p-1.5 rounded-full hover:bg-slate-100 text-slate-500"
              >
                <X className="w-5 h-5" />
              </button>
            </div>

            <form onSubmit={handleSaveEvent} className="space-y-3.5">
              <div>
                <label className="block text-xs font-bold text-[#526586] mb-1">
                  Event Title *
                </label>
                <input
                  type="text"
                  required
                  value={formTitle}
                  onChange={(e) => setFormTitle(e.target.value)}
                  placeholder="e.g. JimmySea Fan Sign / Live Broadcast"
                  className="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm font-semibold text-[#1A3668] focus:outline-none focus:border-purple-400"
                />
              </div>

              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="block text-xs font-bold text-[#526586] mb-1">
                    Date *
                  </label>
                  <input
                    type="date"
                    required
                    value={formDate}
                    onChange={(e) => setFormDate(e.target.value)}
                    className="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm font-semibold text-[#1A3668] focus:outline-none focus:border-purple-400"
                  />
                </div>
                <div>
                  <label className="block text-xs font-bold text-[#526586] mb-1">
                    Time
                  </label>
                  <input
                    type="text"
                    value={formTime}
                    onChange={(e) => setFormTime(e.target.value)}
                    placeholder="e.g. 18:00 BKK"
                    className="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm font-semibold text-[#1A3668] focus:outline-none focus:border-purple-400"
                  />
                </div>
              </div>

              <div>
                <label className="block text-xs font-bold text-[#526586] mb-1.5">
                  Members Involved
                </label>
                <div className="grid grid-cols-3 gap-2">
                  {settings.members.map((m) => {
                    const checked = formMembers.includes(m.id);
                    return (
                      <button
                        type="button"
                        key={m.id}
                        onClick={() => {
                          setFormMembers((prev) =>
                            prev.includes(m.id)
                              ? prev.filter((id) => id !== m.id)
                              : [...prev, m.id]
                          );
                        }}
                        style={{
                          backgroundColor: checked ? m.pillBg : '#F8FAFC',
                          borderColor: checked ? m.pillBorder : '#E2E8F0'
                        }}
                        className="flex items-center justify-center gap-1.5 py-2 px-2 rounded-xl border text-xs font-bold text-[#1A3668] transition-all cursor-pointer"
                      >
                        <span>{m.emoji}</span>
                        <span className="truncate">{m.name}</span>
                        {checked && <Check className="w-3.5 h-3.5 text-purple-700 shrink-0" />}
                      </button>
                    );
                  })}
                </div>
              </div>

              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="block text-xs font-bold text-[#526586] mb-1">
                    Location / Channel
                  </label>
                  <input
                    type="text"
                    value={formLocation}
                    onChange={(e) => setFormLocation(e.target.value)}
                    placeholder="e.g. Siam Paragon"
                    className="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm font-semibold text-[#1A3668] focus:outline-none focus:border-purple-400"
                  />
                </div>
                <div>
                  <label className="block text-xs font-bold text-[#526586] mb-1">
                    Category
                  </label>
                  <input
                    type="text"
                    value={formCategory}
                    onChange={(e) => setFormCategory(e.target.value)}
                    placeholder="Event / Broadcast / Fan Event"
                    className="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm font-semibold text-[#1A3668] focus:outline-none focus:border-purple-400"
                  />
                </div>
              </div>

              <div>
                <label className="block text-xs font-bold text-[#526586] mb-1">
                  External Link (Optional)
                </label>
                <input
                  type="url"
                  value={formLink}
                  onChange={(e) => setFormLink(e.target.value)}
                  placeholder="https://x.com/..."
                  className="w-full rounded-xl border border-slate-200 px-3.5 py-2 text-sm font-semibold text-[#1A3668] focus:outline-none focus:border-purple-400"
                />
              </div>

              <div>
                <label className="block text-xs font-bold text-[#526586] mb-1">
                  Notes / Hashtags (Optional)
                </label>
                <textarea
                  rows={2}
                  value={formNotes}
                  onChange={(e) => setFormNotes(e.target.value)}
                  placeholder="Hashtag trends, dress code, or stream info..."
                  className="w-full rounded-xl border border-slate-200 px-3.5 py-2 text-sm font-semibold text-[#1A3668] focus:outline-none focus:border-purple-400"
                />
              </div>

              <div className="flex items-center justify-end gap-2 pt-2">
                <button
                  type="button"
                  onClick={() => setEventModalOpen(false)}
                  className="px-4 py-2 rounded-full text-xs font-bold text-[#526586] hover:bg-slate-100 cursor-pointer"
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  className="px-5 py-2.5 rounded-full text-xs font-bold text-white bg-[#1A3668] hover:bg-slate-800 shadow-xs cursor-pointer"
                >
                  {editingEvent ? 'Save Changes' : 'Add to Calendar'}
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* MODAL 2: CUSTOMIZE BANNER, GREETING & MEMBER PILLS */}
      {settingsModalOpen && (
        <div className="fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-xs flex items-center justify-center p-4">
          <div className="bg-white rounded-[28px] shadow-xl w-full max-w-md p-6 max-h-[90vh] overflow-y-auto">
            <div className="flex items-center justify-between mb-4">
              <h3 className="text-lg font-bold text-[#1A3668]">
                Customize Banner, Header & Members
              </h3>
              <button
                onClick={() => setSettingsModalOpen(false)}
                className="p-1.5 rounded-full hover:bg-slate-100 text-slate-500"
              >
                <X className="w-5 h-5" />
              </button>
            </div>

            <form onSubmit={handleSaveSettings} className="space-y-4">
              {/* Top Banner Customization Section */}
              <div className="p-3.5 rounded-2xl bg-slate-50 border border-slate-200/80 space-y-3">
                <span className="block text-xs font-bold uppercase tracking-wider text-purple-700">
                  Top Hero Banner
                </span>
                <div>
                  <label className="block text-xs font-bold text-[#526586] mb-1">
                    Banner Badge Tag
                  </label>
                  <input
                    type="text"
                    value={draftBannerTag}
                    onChange={(e) => setDraftBannerTag(e.target.value)}
                    placeholder="OCTOBER 2026 SCHEDULE"
                    className="w-full rounded-xl border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-[#1A3668]"
                  />
                </div>
                <div>
                  <label className="block text-xs font-bold text-[#526586] mb-1">
                    Banner Main Title
                  </label>
                  <input
                    type="text"
                    value={draftBannerTitle}
                    onChange={(e) => setDraftBannerTitle(e.target.value)}
                    placeholder="JIMMY & SEA • AVOCEAN HUB"
                    className="w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm font-bold text-[#1A3668]"
                  />
                </div>
                <div>
                  <label className="block text-xs font-bold text-[#526586] mb-1">
                    Banner Subtitle
                  </label>
                  <input
                    type="text"
                    value={draftBannerSubtitle}
                    onChange={(e) => setDraftBannerSubtitle(e.target.value)}
                    placeholder="Official Fan Schedule, Appearances & Trending Projects"
                    className="w-full rounded-xl border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-[#1A3668]"
                  />
                </div>
                <div>
                  <label className="block text-xs font-bold text-[#526586] mb-1">
                    Banner Color Theme
                  </label>
                  <div className="grid grid-cols-3 gap-2">
                    {BANNER_PRESETS.map((preset) => (
                      <button
                        type="button"
                        key={preset.id}
                        onClick={() => setDraftBannerPreset(preset.id)}
                        style={{ background: preset.gradient }}
                        className={`py-2 px-2 rounded-xl text-[11px] font-bold text-[#1A3668] border-2 cursor-pointer ${
                          draftBannerPreset === preset.id
                            ? 'border-[#1A3668]'
                            : 'border-white'
                        }`}
                      >
                        {preset.name}
                      </button>
                    ))}
                  </div>
                </div>
                <div>
                  <label className="block text-xs font-bold text-[#526586] mb-1">
                    Custom Banner Image URL (Optional)
                  </label>
                  <input
                    type="url"
                    value={draftBannerImageUrl}
                    onChange={(e) => setDraftBannerImageUrl(e.target.value)}
                    placeholder="https://... (leave blank for pastel gradient)"
                    className="w-full rounded-xl border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-[#1A3668]"
                  />
                </div>
              </div>

              <div>
                <label className="block text-xs font-bold text-[#526586] mb-1">
                  Top Greeting Subtitle
                </label>
                <input
                  type="text"
                  value={draftGreeting}
                  onChange={(e) => setDraftGreeting(e.target.value)}
                  placeholder="Hey ErnestTheStan!"
                  className="w-full rounded-xl border border-slate-200 px-3.5 py-2 text-sm font-semibold text-[#1A3668]"
                />
              </div>

              <div className="space-y-3">
                <label className="block text-xs font-bold text-[#526586]">
                  Member Filter Pills (Name, Icon/Emoji & Badge Color)
                </label>
                {draftMembers.map((m, idx) => (
                  <div
                    key={m.id}
                    className="p-3 rounded-2xl bg-slate-50 border border-slate-200/80 flex items-center gap-2.5"
                  >
                    <input
                      type="text"
                      value={m.emoji}
                      onChange={(e) => {
                        const updated = [...draftMembers];
                        updated[idx].emoji = e.target.value;
                        setDraftMembers(updated);
                      }}
                      className="w-11 h-10 text-center rounded-xl border border-slate-200 bg-white text-base"
                      title="Emoji / Icon"
                    />
                    <input
                      type="text"
                      value={m.name}
                      onChange={(e) => {
                        const updated = [...draftMembers];
                        updated[idx].name = e.target.value;
                        setDraftMembers(updated);
                      }}
                      className="flex-1 rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm font-bold text-[#1A3668]"
                      placeholder="Member name"
                    />
                    <input
                      type="color"
                      value={m.circleBg}
                      onChange={(e) => {
                        const updated = [...draftMembers];
                        updated[idx].circleBg = e.target.value;
                        setDraftMembers(updated);
                      }}
                      className="w-9 h-9 rounded-lg cursor-pointer border-0 bg-transparent"
                      title="Badge Circle Color"
                    />
                  </div>
                ))}
              </div>

              <div className="flex items-center justify-end gap-2 pt-2">
                <button
                  type="button"
                  onClick={() => setSettingsModalOpen(false)}
                  className="px-4 py-2 rounded-full text-xs font-bold text-[#526586] hover:bg-slate-100"
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  className="px-5 py-2.5 rounded-full text-xs font-bold text-white bg-[#1A3668] hover:bg-slate-800 cursor-pointer"
                >
                  Save Customizations
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* MODAL 3: BACKUP / EXPORT / IMPORT JSON */}
      {backupModalOpen && (
        <div className="fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-xs flex items-center justify-center p-4">
          <div className="bg-white rounded-[28px] shadow-xl w-full max-w-md p-6">
            <div className="flex items-center justify-between mb-3">
              <h3 className="text-lg font-bold text-[#1A3668]">
                Backup & Restore Schedule
              </h3>
              <button
                onClick={() => setBackupModalOpen(false)}
                className="p-1.5 rounded-full hover:bg-slate-100 text-slate-500"
              >
                <X className="w-5 h-5" />
              </button>
            </div>

            <p className="text-xs font-medium text-[#607494] mb-4">
              Your edits save automatically to the cloud. You can also download a JSON backup file or paste a backup below.
            </p>

            <button
              onClick={handleDownloadBackup}
              className="w-full mb-4 py-2.5 px-4 rounded-xl bg-sky-50 hover:bg-sky-100 text-sky-900 font-bold text-xs flex items-center justify-center gap-2 border border-sky-200 cursor-pointer"
            >
              <Download className="w-4 h-4" />
              <span>Download Current Schedule (.json)</span>
            </button>

            <div className="border-t border-slate-100 pt-3">
              <label className="block text-xs font-bold text-[#526586] mb-1.5">
                Import Schedule JSON
              </label>
              <textarea
                rows={4}
                value={importJsonText}
                onChange={(e) => setImportJsonText(e.target.value)}
                placeholder='Paste backup JSON here...'
                className="w-full rounded-xl border border-slate-200 p-3 text-xs font-mono text-[#1A3668] mb-3"
              />
              <button
                onClick={handleImportBackup}
                disabled={!importJsonText.trim()}
                className="w-full py-2.5 px-4 rounded-xl bg-[#1A3668] disabled:opacity-40 text-white font-bold text-xs flex items-center justify-center gap-2 cursor-pointer"
              >
                <Upload className="w-4 h-4" />
                <span>Restore from JSON</span>
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}