{
  "entities": {
    "ScheduleEvent": {
      "title": "ScheduleEvent",
      "description": "Fan schedule event for Jimmy, Sea, and Avocean",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string" },
        "endDate": { "type": "string" },
        "time": { "type": "string" },
        "endTime": { "type": "string" },
        "timezone": { "type": "string" },
        "location": { "type": "string" },
        "locationUrl": { "type": "string" },
        "posterUrl": { "type": "string" },
        "posterUrls": {
          "type": "array",
          "items": { "type": "string" }
        },
        "members": {
          "type": "array",
          "items": { "type": "string" }
        },
        "category": { "type": "string" },
        "link": { "type": "string" },
        "description": { "type": "string" },
        "hashtags": { "type": "string" },
        "watchPlatforms": {
          "type": "array",
          "items": { "type": "object" }
        },
        "isAllDay": { "type": "boolean" },
        "hasRegistration": { "type": "boolean" },
        "registrationStartDate": { "type": "string" },
        "registrationStartTime": { "type": "string" },
        "registrationEndDate": { "type": "string" },
        "registrationEndTime": { "type": "string" },
        "registrationTimezone": { "type": "string" },
        "registrationUrl": { "type": "string" },
        "registrationNotes": { "type": "string" },
        "notes": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "date", "members"]
    },
    "AppSettings": {
      "title": "AppSettings",
      "description": "Global hub settings, banner configurations, and member options",
      "type": "object",
      "properties": {
        "greeting": { "type": "string" },
        "bannerTitle": { "type": "string" },
        "bannerTitleSize": { "type": "string" },
        "bannerSubtitle": { "type": "string" },
        "bannerSubtitleSize": { "type": "string" },
        "bannerImageUrl": { "type": "string" },
        "bannerPhotos": {
          "type": "array",
          "items": { "type": "string" }
        },
        "bannerFit": { "type": "string" },
        "bannerHeight": { "type": "string" },
        "bannerPreset": { "type": "string" },
        "websiteIcon": { "type": "string" },
        "ownerPin": { "type": "string" },
        "adminPin": { "type": "string" },
        "timeFormat": { "type": "string" },
        "members": {
          "type": "array",
          "items": { "type": "object" }
        },
        "updatedAt": { "type": "string" }
      }
    },
    "FanMessage": {
      "title": "FanMessage",
      "description": "Message left by fan/viewer for Admins and Owner",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderName": { "type": "string" },
        "eventTitle": { "type": "string" },
        "eventDate": { "type": "string" },
        "sourceUrl": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string" },
        "isRead": { "type": "boolean" }
      },
      "required": ["message", "createdAt"]
    },
    "Presence": {
      "title": "Presence",
      "description": "Live fan presence heartbeat session for real-time online count",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "lastSeen": { "type": "number" }
      },
      "required": ["sessionId", "lastSeen"]
    },
    "SiteStats": {
      "title": "SiteStats",
      "description": "Global aggregated site visits and counters",
      "type": "object",
      "properties": {
        "totalVisits": { "type": "number" },
        "lastUpdated": { "type": "string" }
      }
    },
    "FanClub": {
      "title": "FanClub",
      "description": "Fan club directory entry with social links, banner, and upcoming events",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "actor": { "type": "string" },
        "countryCode": { "type": "string" },
        "countryName": { "type": "string" },
        "flagEmoji": { "type": "string" },
        "description": { "type": "string" },
        "handle": { "type": "string" },
        "bannerUrl": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "isOfficialOrVerified": { "type": "boolean" },
        "socials": {
          "type": "array",
          "items": { "type": "object" }
        },
        "events": {
          "type": "array",
          "items": { "type": "object" }
        },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "countryName"]
    },
    "AdminAccount": {
      "title": "AdminAccount",
      "description": "Admin or Owner account with role and assigned scope category (General vs Fan Club Admin)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "adminCategory": { "type": "string" },
        "assignedClubId": { "type": "string" },
        "assignedClubName": { "type": "string" },
        "assignedClubIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "assignedClubNames": {
          "type": "array",
          "items": { "type": "string" }
        },
        "assignedFoodProjectId": { "type": "string" },
        "assignedFoodProjectTitle": { "type": "string" },
        "status": { "type": "string" },
        "displayName": { "type": "string" },
        "password": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "approvedAt": { "type": "string" },
        "approvedBy": { "type": "string" },
        "lastLoginAt": { "type": "string" }
      },
      "required": ["id", "email", "role", "password"]
    }
  },
  "firestore": {
    "/events/{eventId}": {
      "schema": "ScheduleEvent",
      "description": "Collection of all schedule events"
    },
    "/settings/global": {
      "schema": "AppSettings",
      "description": "Global configuration document for hub"
    },
    "/fan_clubs/{clubId}": {
      "schema": "FanClub",
      "description": "Collection of fan clubs and their organized events"
    },
    "/fan_messages/{messageId}": {
      "schema": "FanMessage",
      "description": "Fan messages submitted via Leave a Message"
    },
    "/presence/{sessionId}": {
      "schema": "Presence",
      "description": "Live active viewer presence heartbeats"
    },
    "/stats/global": {
      "schema": "SiteStats",
      "description": "Total visits and site stats"
    },
    "/admin_accounts/{accountId}": {
      "schema": "AdminAccount",
      "description": "Admin and Owner accounts with scope categories and permissions"
    }
  }
}
