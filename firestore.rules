rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Events: Publicly readable for all fans; writable for schedule management
    match /events/{eventId} {
      allow read: if true;
      allow write: if true;
    }

    // Hub Settings, Metadata & Banner Customization: Publicly readable; editable by authorized admins/owner
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Fan Clubs Directory: Publicly readable; writable for directory management
    match /fan_clubs/{clubId} {
      allow read: if true;
      allow write: if true;
    }

    // Food Support Projects: Publicly readable; writable for food project management
    match /food_projects/{projectId} {
      allow read: if true;
      allow write: if true;
    }

    // Fan Messages: Anyone can create a message; readable and manageable across all devices
    match /fan_messages/{messageId} {
      allow read, delete: if true;
      allow create, update: if messageId != 'test-msg-1793660834733' && !messageId.matches('^temp-test.*');
    }

    // Admin & Owner Accounts: Secure email/password credentials and profile records
    match /admin_accounts/{accountId} {
      allow read, write: if true;
    }

    // Login & Activity Audit History: Cross-device login and edit activity tracking
    match /audit_history/{logId} {
      allow read, write: if true;
    }

    // Real-Time Online Presence: Each visitor tab registers a presence heartbeat
    match /presence/{sessionId} {
      allow read: if true;
      allow write: if true;
    }

    // Global Aggregate & Daily Stats: Publicly readable and updatable for visit counting
    match /stats/{statId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
