rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Events: Publicly readable for all fans; writable for schedule management
    match /events/{eventId} {
      allow read: if true;
      allow write: if true;
    }

    // Hub Settings, Metadata & Banner Customization: Publicly readable; editable by authorized admins/owner
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Fan Messages: Anyone can create a message; readable and manageable
    match /fan_messages/{messageId} {
      allow create: if request.resource.data.message is string;
      allow read, update, delete: if true;
    }

    // Real-Time Online Presence: Each visitor tab registers a presence heartbeat
    match /presence/{sessionId} {
      allow read: if true;
      allow write: if true;
    }

    // Global Aggregate & Daily Stats: Publicly readable and updatable for visit counting
    match /stats/{statId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
